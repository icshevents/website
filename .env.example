NEXT_PUBLIC_SITE_URL=https://www.icsh.org.uk
# Set only after launch approval. Preview builds remain noindex.
SITE_LAUNCHED=false
NEXT_PUBLIC_SUPABASE_URL=https://xxtsbuvwvrvtvmdxwcpx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key
# Server-only: used by event forms and the durable membership test-application store.
# Requires database/membership-applications.sql in the existing database.
SUPABASE_SECRET_KEY=

# Zoho connection checks remain organiser-only and read-only.
# Select the actual account region; no default region is assumed.
# Save client IDs, secrets and refresh tokens privately in Vercel.
# Never use NEXT_PUBLIC_ for any Zoho variable.
ZOHO_BIGIN_ACCOUNTS_URL=
ZOHO_BIGIN_API_DOMAIN=
ZOHO_BIGIN_CLIENT_ID=
ZOHO_BIGIN_CLIENT_SECRET=
ZOHO_BIGIN_REFRESH_TOKEN=
# Separate, server-only Member Search Tool connection. Requires Contacts READ
# and ZohoSearch.securesearch.READ. Its code exposes no contact write operation.
# Existing registration credentials above remain independent.
ZOHO_BIGIN_LOOKUP_ACCOUNTS_URL=
ZOHO_BIGIN_LOOKUP_API_DOMAIN=
ZOHO_BIGIN_LOOKUP_CLIENT_ID=
ZOHO_BIGIN_LOOKUP_CLIENT_SECRET=
ZOHO_BIGIN_LOOKUP_REFRESH_TOKEN=
# Keep false until the separate controlled Bigin test has been authorised and configured.
# Requires Contacts READ/CREATE and ZohoSearch.securesearch.READ, in addition to metadata READ.
# No UPDATE, WRITE or ALL scope is needed. Public submissions never call Bigin automatically.
ZOHO_BIGIN_MEMBERSHIP_WRITES_ENABLED=false
ZOHO_CAMPAIGNS_ACCOUNTS_URL=
ZOHO_CAMPAIGNS_API_DOMAIN=
ZOHO_CAMPAIGNS_CLIENT_ID=
ZOHO_CAMPAIGNS_CLIENT_SECRET=
ZOHO_CAMPAIGNS_REFRESH_TOKEN=

# Membership payments: live keys only on Production, test keys only on Preview.
# Store real credentials as Vercel Secrets; never commit values.
STRIPE_MEMBERSHIP_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_SITE_URL=

# Shared donation and future ticket checkout. Uses the same website key and signed webhook.
STRIPE_WEBSITE_PAYMENTS_ENABLED=false

# Verified paid memberships activate the matched contact; recovery job is private.
ZOHO_BIGIN_MEMBERSHIP_ACTIVATION_ENABLED=false
CRON_SECRET=

# Stable IDs for new website contacts; private recovery job.
ZOHO_BIGIN_MEMBER_IDS_ENABLED=false
MEMBER_ID_JOB_SECRET=
